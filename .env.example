# === НАСТРОЙКИ БОТА AiBM ===
# Скопируй этот файл в .env (cp .env.example .env) и заполни значения.
# Без BOT_TOKEN и ADMIN_ID бот не запустится — это обязательные поля.

# --- Telegram (ОБЯЗАТЕЛЬНО) ---
# Токен бота берёшь у @BotFather
BOT_TOKEN=123456789:AaBbCcDdEeFfGgHh...
# Твой личный Telegram ID (число). Узнать у @userinfobot
ADMIN_ID=123456789

# --- Grok API / xAI (необязательно, но желательно) ---
# Ключ из https://console.x.ai — если пусто, бот пропустит ИИ-анализ
GROK_API_KEY=
GROK_MODEL=grok-2-latest
GROK_BASE_URL=https://api.x.ai/v1

# --- Notion (необязательно) ---
# Токен интеграции из https://www.notion.so/my-integrations
# Не забудь «расшарить» базу «Клиенты» на свою интеграцию!
NOTION_TOKEN=
# ID базы Notion (32 символа из ссылки на базу)
NOTION_DATABASE_ID=

# --- Прочее (можно не трогать) ---
DB_PATH=bot.db
ANTISPAM_SECONDS=0.5
